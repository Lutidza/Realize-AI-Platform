{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@payload-config": ["./src/payload.config.ts"],
      "@/*": ["src/*"],
      "@/payload-types": ["./src/payload-types.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".ai-workspace/tasks/2026-10-06-ai-usage-groups-a6c2/tmp/next/types/**/*.ts",
    ".ai-workspace/tasks/2026-10-06-ai-usage-groups-a6c2/tmp/next/dev/types/**/*.ts",
    ".ai-workspace/tasks/2026-10-11-task-manager-foundation-d3c9/tmp/task-browser-ab461b90e457207b/next/types/**/*.ts",
    ".ai-workspace/tasks/2026-10-11-task-manager-foundation-d3c9/tmp/task-browser-ab461b90e457207b/next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "src/RealizeCore/**", "src/app/_realize/**"]
}
