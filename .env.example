NODE_ENV=development

POSTGRES_DB=realize_ecommerce
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_PORT=55432
POSTGRES_USER=realize
DATABASE_URI=postgres://realize:replace-with-strong-database-password@127.0.0.1:55432/realize_ecommerce
DATABASE_URL=postgres://realize:replace-with-strong-database-password@127.0.0.1:55432/realize_ecommerce
COMPOSE_DATABASE_URI=postgres://realize:replace-with-strong-database-password@postgres:5432/realize_ecommerce
PAYLOAD_SECRET=replace-with-strong-secret
PREVIEW_SECRET=replace-with-preview-secret

NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_PUBLIC_LIVE_PREVIEW_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

SITE_NAME="Realize — AI Platform"
COMPANY_NAME="Realize"
TWITTER_CREATOR=
TWITTER_SITE=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOKS_SIGNING_SECRET=

POSTGRES_SSL=false
# Never enable for a retained or adopted database. This is only for disposable local schema work.
PAYLOAD_DB_PUSH=false

APP_PORT=3000
REALIZE_IMAGE=realize-ai-platform:local
RELEASE_ID=development

# Включение агента, модели, разрешения операций и TTL — Admin → Интеграции → GPT — Codex → Агент.
# Здесь только инфраструктура control plane / worker; без подключения Admin агент недоступен.
REALIZE_AI_COMPILE_TIME_OMIT=false
# npm run dev запускает локальные AI-сервисы; central-control-plane использует внешний сервис.
REALIZE_AI_RUNTIME_MODE=local-development
REALIZE_AI_CONTROL_PLANE_URL=
REALIZE_AI_CONTROL_PLANE_HOST=127.0.0.1
REALIZE_AI_CONTROL_PLANE_PORT=3100
REALIZE_AI_CONTROL_PLANE_TOKEN=replace-with-a-random-value-of-at-least-32-characters
REALIZE_AI_WORKSPACE_ROOT=

# Одинаковая identity в web, control plane и worker; один Payload DB — одна установка.
REALIZE_INSTALLATION_ID=local-installation
REALIZE_PROJECT_ID=local-project
REALIZE_PLATFORM_RELEASE_ID=
# Только числовые ID существующих owner users, через запятую. Пусто — owner-доступ закрыт.
REALIZE_PLATFORM_OWNER_USER_IDS=

# Инженерный режим владельца: включить true одинаково в web и control plane.
# Только Linux/local-development; control plane реально запускается от указанного OS user.
# Рабочая копия — REALIZE_AI_WORKSPACE_ROOT; режим использует полные права этого пользователя.
REALIZE_AI_OWNER_ENGINEERING_ENABLED=false
REALIZE_AI_OWNER_ENGINEERING_OS_USER=gio
# Необязательный приватный каталог control plane вне checkout (0700, без symlink).
# Пусто: ~/.local/share/realize-ai-cms/owner-engineering. Журнал нельзя сбрасывать для replay.
REALIZE_AI_OWNER_ENGINEERING_STATE_ROOT=

# Приватные вложения чата: абсолютный постоянный каталог control plane вне checkout.
REALIZE_AI_CHAT_ASSET_ROOT=

# Общий постоянный каталог одной установки; личный ~/.codex не используется.
# Пустые значения: системный PATH и ~/.local/share/realize-ai-cms/codex.
REALIZE_CODEX_BINARY=
REALIZE_CODEX_STATE_ROOT=

# Только для workload identity: правило доверия OpenAI и обновляемый файл токена.
# Абсолютный путь вне checkout; каталог 0700, файл 0400 или 0600, без symlink.
REALIZE_CODEX_FEDERATION_RULE_ID=
REALIZE_CODEX_IDENTITY_TOKEN_FILE=

# npm run dev поднимает отдельный локальный worker; этапы включаются в Admin.
# Рабочие каталоги находятся вне репозитория. Production использует отдельную
# изолированную identity/container, а не это локальное окружение.
REALIZE_AI_EXECUTION_SIGNING_SECRET=replace-with-a-separate-random-value-of-at-least-32-characters
REALIZE_AI_EXECUTION_WORKSPACE_ROOT=
REALIZE_AI_EXECUTION_WORKER_ID=
REALIZE_AI_EXECUTION_POLL_MS=2000
REALIZE_AI_EXECUTION_TURN_TIMEOUT_MS=1200000

# Accepted diffs may be promoted only into a loopback, TTL-bound local preview.
# The promotion root must be outside the repository. Production images and
# remote delivery remain a separate workflow.
REALIZE_AI_PROMOTION_WORKSPACE_ROOT=
REALIZE_AI_PREVIEW_ROOT=
REALIZE_AI_PREVIEW_HOST=127.0.0.1
REALIZE_AI_PREVIEW_PORT_MIN=3200
REALIZE_AI_PREVIEW_PORT_MAX=3299
REALIZE_AI_PREVIEW_STARTUP_TIMEOUT_MS=120000
REALIZE_AI_REVIEW_TIMEOUT_MS=600000

# Публикация accepted preview commit в отдельную GitHub-ветку и draft PR.
# Main/current checkout не изменяются; GitHub connection настраивается в Admin.
REALIZE_AI_SOURCE_PROMOTION_TIMEOUT_MS=120000

# Подготовка OCI release — отдельная opt-in очередь для server-owned команды
# orchestrator. Она не выдаёт право на production deployment.
REALIZE_AI_RELEASE_ORCHESTRATOR_COMMAND=
REALIZE_AI_RELEASE_ORCHESTRATOR_ARGS_JSON=[]
REALIZE_AI_RELEASE_ORCHESTRATOR_ENV_JSON=["REALIZE_AI_GITHUB_GH_COMMAND","REALIZE_AI_GITHUB_GIT_COMMAND","REALIZE_AI_GITHUB_POLL_MS","REALIZE_AI_GITHUB_RUN_TIMEOUT_MS","REALIZE_AI_GITHUB_WORKFLOW","REALIZE_AI_GITHUB_WORKFLOW_REF"]
REALIZE_AI_RELEASE_TIMEOUT_MS=7200000

# Admin integration credentials use an installation-local AES-256-GCM vault.
# Generate exactly 32 random bytes as base64, for example: openssl rand -base64 32
REALIZE_INTEGRATIONS_ENCRYPTION_KEY=

# GitHub adapter infrastructure. Repository/token are normally saved through
# /admin/integrations; these two values remain a bootstrap fallback only.
GH_TOKEN=
REALIZE_AI_GITHUB_REPOSITORY=
REALIZE_AI_GITHUB_WORKFLOW=prepare-release-candidate.yml
REALIZE_AI_GITHUB_WORKFLOW_REF=main
REALIZE_AI_GITHUB_GH_COMMAND=/usr/bin/gh
REALIZE_AI_GITHUB_GIT_COMMAND=/usr/bin/git
REALIZE_AI_GITHUB_POLL_MS=5000
REALIZE_AI_GITHUB_RUN_TIMEOUT_MS=5400000

# Internal MCP is started explicitly with npm run mcp:serve; see documentation/architecture/mcp-tooling.md.
# Choose managed for Admin registry or bootstrap for exported, repository-only settings.
REALIZE_MCP_CONFIGURATION_MODE=
REALIZE_MCP_SERVER_ID=
REALIZE_MCP_HOST_PROFILE_ID=
REALIZE_MCP_HOST_PROFILES=[]
REALIZE_MCP_CONTROL_LOCAL=
# Bootstrap never loads .env itself. Do not mix these values with managed mode.
REALIZE_MCP_REPOSITORY_READ_ENABLED=
REALIZE_MCP_REPOSITORY_ROOT=
REALIZE_MCP_PRINCIPAL_ID=
REALIZE_MCP_TOKEN=
REALIZE_MCP_PORT=
